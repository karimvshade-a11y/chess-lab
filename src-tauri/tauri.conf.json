{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chess Lab",
  "version": "0.2.0",
  "identifier": "app.chesslab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chess Lab",
        "width": 1180,
        "height": 860,
        "minWidth": 900,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/stockfish"
    ],
    "resources": [
      "resources/*"
    ]
  }
}
